{
  "name": "essence-radio",
  "version": "1.0.0",
  "description": "Essence Radio - Live Audio Streaming App",
  "private": true,
  "scripts": {
    "install:all": "cd backend && npm install && cd ../web && npm install && cd ../mobile && npm install --legacy-peer-deps",
    "install:backend": "cd backend && npm install",
    "install:web": "cd web && npm install",
    "install:mobile": "cd mobile && npm install --legacy-peer-deps",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:web": "cd web && npm run dev",
    "dev:mobile": "cd mobile && npm start",
    "build:backend": "cd backend && npm run build",
    "build:web": "cd web && npm run build",
    "build:all": "npm run build:backend && npm run build:web",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "deploy:railway": "bash scripts/deploy-railway.sh",
    "setup:prod": "bash scripts/setup-production.sh"
  }
}
